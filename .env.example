# ApexPM — copy to bot/.env and fill in. NEVER commit .env.

# ── Kalshi API ───────────────────────────────────────────────
KALSHI_API_KEY_ID=your-key-id-here
# Base64 of your downloaded key file goes in the VALUE (never the variable name).
# macOS: base64 -i kalshi-key.pem | pbcopy
KALSHI_PRIVATE_KEY_B64=

# ── Safety ───────────────────────────────────────────────────
DRY_RUN=true          # paper trading. Set false only when you mean it.
USE_DEMO=true         # Kalshi demo exchange
BANKROLL=100

# ── Strategy overrides (optional; defaults live in bot.py) ───
# MIN_EDGE_CENTS=3
# MAX_POS_PCT=0.05
# MAX_TRADE_USD=10
# MAX_POSITIONS=3
# SCAN_INTERVAL=30
# EVENT_BLACKLIST=TICKER-1,TICKER-2

# ── Daily email report (optional) ────────────────────────────
EMAIL_ENABLED=false
REPORT_EMAIL=you@example.com
SENDGRID_API_KEY=
